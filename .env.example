# ============================================================
# Kasku — contoh konfigurasi. Salin ke .env lalu isi nilainya:
#   cp .env.example .env
# JANGAN commit file .env.
# ============================================================

# --- Database (Docker Compose) ---
POSTGRES_DB=kasku
POSTGRES_USER=kasku
# Buat dengan: openssl rand -hex 24
POSTGRES_PASSWORD=ganti-dengan-password-acak

# --- Untuk menjalankan tanpa Docker (npm run dev) ---
DATABASE_URL=postgresql://kasku:kasku-dev@localhost:5432/kasku?schema=public
# Database khusus test integrasi (nama wajib berakhiran _test)
TEST_DATABASE_URL=postgresql://kasku:kasku-dev@localhost:5432/kasku_test?schema=public

# --- Aplikasi ---
# URL publik dashboard (juga dipakai untuk webhook Telegram di Tahap 2)
APP_URL=http://localhost:3000
# Domain untuk Caddy (HTTPS otomatis), mis. keuangan.rumahku.id
DOMAIN=localhost
# Masa berlaku sesi login (hari)
SESSION_TTL_DAYS=30
# Cookie hanya dikirim lewat HTTPS. Set false hanya jika diakses tanpa HTTPS di LAN.
COOKIE_SECURE=true

# --- Bot Telegram (Tahap 2) ---
# Token dari @BotFather
TELEGRAM_BOT_TOKEN=
# Rahasia webhook (16-256 karakter: huruf, angka, _ atau -). Buat: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# ID numerik akun Telegram yang boleh memakai bot, pisahkan dengan koma.
# Cari ID-mu lewat @userinfobot.
TELEGRAM_ALLOWED_USER_IDS=

# --- Foto struk (Tahap 3) ---
# Redis untuk antrean (Docker). Pakai hex acak: openssl rand -hex 24
REDIS_PASSWORD=ganti-dengan-hex-acak
# Non-Docker: isi untuk memakai antrean + `npm run worker`. Kosong = diproses langsung.
REDIS_URL=
# MinIO (Docker). Secret minimal 8 karakter: openssl rand -hex 24
S3_ACCESS_KEY=kasku
S3_SECRET_KEY=ganti-dengan-hex-acak
S3_BUCKET=kasku-receipts
# Non-Docker: s3 | local (default, folder ./storage)
STORAGE_DRIVER=
# Pembaca struk: tesseract (gratis, lokal) | http (layanan OCR/AI sendiri) | mock
RECEIPT_PROVIDER=tesseract
RECEIPT_HTTP_URL=
RECEIPT_HTTP_TOKEN=

# --- Seed pengguna pertama (opsional; bisa juga npm run user:create) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
# Buat contoh rekening (Tunai, BCA, Mandiri, GoPay, OVO, Kartu Kredit)
SEED_SAMPLE_ACCOUNTS=true

# --- Backup ---
BACKUP_KEEP_DAYS=14
